# Own regression tests of Open 386MAX (TESTS/<DIR>/<NAME>.ASM).
# NAME [timeout=S] [keys] [floppy] [needs=...] [-- ARGS]
# needs: xms ems vcpi vds qpi mouse; dpmi (16-bit clients) dpmi32 dpmi1 (DPMI 1.0)
#        xlat (DOS/BIOS API translation in protected mode: 386MAX, HDPMI; not CWSDPMI)
# Errorlevel 0 = PASS.  Run with linux/test/suite.py (QEMU) or RUNTESTS.BAT (DOS).
XMS/XMSFUNC   needs=xms timeout=120
XMS/XMS35     needs=xms
XMS/XMSUMB    needs=xms
XMS/XMSLOCK   needs=xms
EMS/EMSFUNC   needs=ems
EMS/EMSMORE   needs=ems
VCPI/VCPIFUNC needs=vcpi
VDS/VDSFUNC   needs=vds
V86/V86FUNC
V86/INT15
V86/A20
MAX/MAXINFO
MAX/UMBDOS
MAX/HMADOS
MAX/UTIL      timeout=120
DPMI/DPMI10   needs=dpmi,dpmi1
DPMI/DPMIMISC needs=dpmi,xlat
DPMI/MAXAPI   needs=dpmi,xlat
DPMI/RMCBNEST needs=dpmi timeout=90
DPMI/PMSTACK  needs=dpmi,xlat timeout=60
DPMI/CALLGATE needs=dpmi,xlat
DPMI/NULLSEG  needs=dpmi,xlat
DPMI/LINOOM   needs=dpmi,xlat
DPMI/MANYSEL  needs=dpmi,xlat timeout=60
DPMI/DPMILEAK needs=dpmi timeout=90
DPMI/DOSXLAT  needs=dpmi,xlat
DPMI/XLAT32   needs=dpmi32,xlat
DPMI/PM26     needs=dpmi timeout=60
DPMI/DISKIO   needs=dpmi,xlat timeout=60
DPMI/STKFLT   needs=dpmi term
DPMI/XMSMAP   needs=dpmi,xms
DPMI/XMS35PM  needs=dpmi,xms
DPMI/LOWLIN   needs=dpmi,dpmi1,xlat
DPMI/BIGMEM   needs=dpmi
DPMI/HDPAPI   needs=dpmi32
DPMI/HDPTRAP  needs=dpmi32
DPMI/HDPSHR   needs=dpmi32
DPMI/EXEC32   needs=dpmi32,xlat
DPMI/MOUSE12  needs=dpmi,mouse
DPMI/MOUSE18  needs=dpmi,mouse
QPI/QPITEST   needs=qpi
QPI/QPITRAP   needs=qpi
QPI/QPIMISC   needs=qpi
QPI/QPICTX    needs=qpi,ems
QPI/QPIIRQ    needs=qpi
QPI/QPITIMER  needs=qpi
QPI/QPICRT    needs=qpi
QPI/QPIVID    needs=qpi
QPI/QPIPROT   needs=qpi
