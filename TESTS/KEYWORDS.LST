# 386MAX.PRO keyword tests for linux/test/kwtest.py (see there):
# NAME [@mem=MB] [@cpu=MODEL] [@cfg=LINE] KEYWORD;KEYWORD... | EXPECTATIONS
# QEMU (SeaBIOS, -vga std): VGA ROM C000-C9A0, option ROMs CA00, E780;
# default EMS frame D400, about 24KB of UMBs.
DEFAULT    - | XMS=350 EMS=40 EMSFRAME=D400 VCPI>0 DPMI>0 VDS=1 QPI=1 MAXDEV=1 HMA=1 XMSHANDLES=1F SCR~Open_386MAX SCR!~Warning SCR!~Unable
FRAMED000  FRAME=D000 | EMSFRAME=D000 EMS=40
NOFRAME    NOFRAME | EMSFRAME=FFFF0000 EMS=40 UMBFREEKB>=50
EMS0       EMS=0 | EMS=0 XMS=350 DPMI>0
NODPMI     NODPMI | DPMI=0 XMS=350 EMS=40
# not in this version (other OEMs):  NOHMA, NUMHANDLES=, LOWFRAME (HP), HIGHDOS (ILIM),
# EEMS, SLOWKEYB, INBOARD, JET386
XMSHNDL100 XMSHNDL=100 | XMSHANDLES=63
NOHIGH     NOHIGH | UMBFREEKB=0
USEB000    USE=B000-B800 | UMBFREEKB>=38
# no 64KB above 640KB:  no EMS frame (a frame in conventional memory hung MS-DOS)
EXCLD000   EXCLUDE=D000-E000 | %OK EMSFRAME=FFFF0000 EMS=40 EMSFREE>0 CONVKB=280 SCR~No_room_for_a_64KB
VIDMEM     VIDMEM=B800-C000 | %OK
EXT16M     EXTSIZE=16384 | XMSTOTAL<=4000 XMS=350
NOVME      NOVME | DPMI>0 VCPI>0
NOWIN3     NOWIN3 | SCR!~VxD XMS=350
VGASWAP    VGASWAP | SCR!~Unable ROM~C000
SXMS       @mem=6144 @cpu=pentium3 - | SXFREE=300000 XMS=350 I15E820HI=0 I15E801HI=6B1D
NOSXMS     @mem=6144 @cpu=pentium3 NOSXMS | SXFREE=0 XMS=350 I15E820HI=1
UNKNOWN    FOOBAR | SCR~Unknown_keyword DOSVER>0
AMRS8      AMRS=8 | %OK EMS=40
ON         ON | %OK EMS=40
AUTO       AUTO | SCR!~Unknown_keyword DOSVER>0
DMA64      DMA=64 | %OK VDS=1
32BITDMA   32BITDMA | %OK
SLOWDMA    SLOWDMA | %OK
NOEISADMA  NOEISADMA | %OK
NOSCSI     NOSCSI | %OK
NODMA      NODMA | %OK
NO4B       NO4B | %OK VDS=1
DPMIMEM    DPMIMEM=512 | %OK DPMI>0
LOWDPMI0   LOWDPMI=0 | %OK DPMI>0
LOWDPMI8M  LOWDPMI=8192 | %OK DPMI>0
EXT4096    EXT=4096 | %OK I1588>=F00 I15E801>=F00 I15E801HI=0
HMAMIN40   HMAMIN=40 | %OK HMA=1
PRGREG0    PRGREG=0 | %OK
STACKS     STACKS=9,256 | %OK
ISTACKS    ISTACKS | %OK
XBIOSHI    XBIOSHI | %OK
NOXBIOS    NOXBIOS | %OK
NOSCAN     NOSCAN=C800-CA00 | %OK
USERAM     USE=B000-B800;RAM=B000-B400 | %OK UMBFREEKB<38
INCLB000   INCLUDE=B000-B800 | %OK
ROMC000    ROM=C000-C800 | %OK
NOROM      NOROM | %OK
SHADOWRAM  SHADOWRAM | %OK
SHADOWROM  SHADOWROM | %OK
NOCOMPROM  NOCOMPROM | %OK
NOXRAM     NOXRAM | %OK
TOP384     TOP384 | %OK
NOFLEX     NOFLEX | %OK
NOVGASIG   NOVGASIG | %OK
IGNFLEXFR  IGNOREFLEXFRAME | %OK
MONO       MONO | %OK
CGA        CGA | %OK
EGA        EGA | %OK
VGA        VGA | %OK
SCREEN     SCREEN | %OK
NOLOADHI   NOLOADHI | %OK
NOLOADHIGH NOLOADHIGH | %OK
NOLOW      NOLOW | %OK CONVKB=280
NOPNP      NOPNP | %OK
NOWARMBOOT NOWARMBOOT | %OK
NOPARITY   NOPARITY | %OK
NOPULSE    NOPULSE | %OK
NOSCRUB    NOSCRUB | %OK
NOTIME     NOTIME | %OK
RESETKEYB  RESETKEYB | %OK
FORCEA20   FORCEA20 | %OK HMA=1
NOGATE     NOGATE | %OK
TERSE      TERSE | %OK SCR!~Memory_Usage
NO58       NO58 | %OK
NOABIOS    NOABIOS | %OK
MCE        MCE | %OK
NOCACHE    NOCACHE | %OK
WEITEKOFF  WEITEK=OFF | %OK
NOWIN30    NOWIN30 | %OK
NOCRR      NOCRR | %OK
IOWRAP     IOWRAP | %OK
EMS30      EMS30 | %OK EMS=40
DOS4       DOS4 | %OK
DOS5       DOS5 | %OK
SWAPFILE   SWAPFILE=C:\MAX\386MAX.SWP | %OK DPMI>0
EXTBIG     @mem=3072 EXTSIZE=2500000 | SCR~Warning,_EXTSIZE= DOSVER>0
LOWFR9000  FRAME=9000 | %OK EMSFRAME=FFFF0000 EMS=40 CONVKB=280 SCR~No_room_for_a_64KB
