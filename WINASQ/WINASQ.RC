/* WINASQ.RC:  ASQ for Windows */
#include <windows.h>
#include "winasq.h"

WinAsqIcon ICON "WINASQ.ICO"

WinAsqMenu MENU
BEGIN
	POPUP TXT_FILE
	BEGIN
		MENUITEM TXT_NEW, IDM_NEW
		MENUITEM TXT_OPEN, IDM_OPEN
		MENUITEM SEPARATOR
		MENUITEM TXT_EXIT, IDM_EXIT
	END
	POPUP TXT_HELP
	BEGIN
		MENUITEM TXT_ABOUT, IDM_ABOUT
	END
END

IDD_ABOUT DIALOG 40, 40, 200, 70
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION TXT_TITLE
FONT 8, "MS Sans Serif"
BEGIN
	CTEXT "", IDC_VERSION, 10, 10, 180, 10
	CTEXT TXT_TITLE, -1, 10, 22, 180, 10
	CTEXT "GNU General Public License version 3", -1, 10, 34, 180, 10
	DEFPUSHBUTTON "OK", IDOK, 80, 50, 40, 14
END

IDD_NEWSNAP DIALOG 40, 40, 220, 76
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION TXT_NEWTITLE
FONT 8, "MS Sans Serif"
BEGIN
	LTEXT TXT_SNAPTITLE, -1, 8, 10, 36, 10
	EDITTEXT IDC_SNAPTITLE, 46, 8, 166, 12, ES_AUTOHSCROLL
	LTEXT TXT_SNAPFILE, -1, 8, 28, 36, 10
	EDITTEXT IDC_SNAPFILE, 46, 26, 166, 12, ES_AUTOHSCROLL
	DEFPUSHBUTTON "OK", IDOK, 110, 54, 48, 14
	PUSHBUTTON TXT_CANCEL, IDCANCEL, 164, 54, 48, 14
END
