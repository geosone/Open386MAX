/* WINASQ.RC:  ASQ for Windows */
#include <windows.h>
#include "winasq.h"

WinAsqIcon ICON "WINASQ.ICO"

WinAsqMenu MENU
BEGIN
	POPUP TXT_FILE
	BEGIN
		MENUITEM TXT_OPEN, IDM_OPEN
		MENUITEM SEPARATOR
		MENUITEM TXT_EXIT, IDM_EXIT
	END
	POPUP TXT_HELP
	BEGIN
		MENUITEM TXT_ABOUT, IDM_ABOUT
	END
END

IDD_ABOUT DIALOG 40, 40, 200, 70
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION TXT_TITLE
FONT 8, "MS Sans Serif"
BEGIN
	CTEXT "", IDC_VERSION, 10, 10, 180, 10
	CTEXT TXT_TITLE, -1, 10, 22, 180, 10
	CTEXT "GNU General Public License version 3", -1, 10, 34, 180, 10
	DEFPUSHBUTTON "OK", IDOK, 80, 50, 40, 14
END
