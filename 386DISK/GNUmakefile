# 386DISK.SYS, 386DISK.COM and RAMTEMP.COM (GNU make, see linux/mk/dos.mk)
PROJ     := 386DISK
ROOT     := $(abspath ..)
SRCDIRS  := . ../386MAX
ASMINC   := . ../INC ../386MAX
GENERATED := QDSK_OEM.INC=QDSK@RET.OEM
PROGS    := 386DISK.SYS 386DISK.COM RAMTEMP.COM

386DISK.SYS_OBJS := QDISK.OBJ QDISK_IN.OBJ VERSRET.OBJ
386DISK.SYS_MAP  := 386DISK.map
386DISK.SYS_BIN  := 1
RAMTEMP.COM_OBJS := RAMTEMP.OBJ
# 386DISK.COM contains 386DISK.SYS (INCBIN from $(OUT))
386DISK.COM_OBJS := DISKCOM.OBJ

include $(ROOT)/linux/mk/dos.mk

$(OUT)/DISKCOM.OBJ: $(OUT)/386DISK.SYS
